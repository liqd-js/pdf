:ws
    =/[\s\n]+/

:string
	=/"(?<string>([^\\"\r\n]|\\[^\r\n])*?)"/
	=/'(?<string>([^\\'\r\n]|\\[^\r\n])*?)'/

	$ => Util.unescape( $.string )

:attribute
	name=/[a-zA-Z_][a-zA-Z0-9_:-]*/ "=" value=:string
	name=/[a-zA-Z_][a-zA-Z0-9_:-]*/

:header
    "<header>" template=/[\s\S]*?(?=<\/header>)/ "</header>"
    "<header" :ws attributes=?...[:ws]:attribute ?:ws ">" template=/[\s\S]*?(?=<\/header>)/ "</header>"

    $ => ({ attributes: Object.fromEntries(( $.attributes || []).map( a => [ a.name, a.value ?? null ])), template: $.template?.trim()  })

:footer
    "<footer>" template=/[\s\S]*?(?=<\/footer>)/ "</footer>"
    "<footer" :ws attributes=?...[:ws]:attribute ?:ws ">" template=/[\s\S]*?(?=<\/footer>)/ "</footer>"

    $ => ({ attributes: Object.fromEntries(( $.attributes || []).map( a => [ a.name, a.value ?? null ])), template: $.template?.trim()  })

:maincontent
    "<main>" template=/[\s\S]*?(?=<\/main>)/ "</main>"
    "<main" :ws attributes=?...[:ws]:attribute ?:ws ">" template=/[\s\S]*?(?=<\/main>)/ "</main>"

    $ => ({ attributes: Object.fromEntries(( $.attributes || []).map( a => [ a.name, a.value ?? null ])), template: $.template?.trim()  })

:helper
    =/<helpers>[\s\n]*(?<template>[\s\S]*?)[\s\n]*<\/helpers>/

:blocks
    =:helper
    =:header
    =:footer
    main=:maincontent

    $ => ({ type: Object.keys( $ )[0], ...Object.values( $ )[0] })

:main
    "<pdf" ?:ws attributes=?...[:ws]:attribute ?:ws ">" ?:ws blocks=...[:ws]:blocks ?:ws "</pdf>"

    $ => ({ attributes: Object.fromEntries(( $.attributes || []).map( a => [ a.name, a.value ?? null ])), blocks: $.blocks })